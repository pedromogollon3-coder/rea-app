{
  "name": "rea-app",
  "version": "0.1.0",
  "description": "Ingeniería inversa de aplicaciones web con evidencia: motor Playwright, servidor MCP, CLI y plugin de Claude Code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rea-app": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "scripts/setup.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "demo": "node examples/demo-app/server.mjs"
  },
  "keywords": [
    "reverse-engineering",
    "web-app",
    "spa",
    "websocket",
    "playwright",
    "mcp",
    "claude-code",
    "plugin"
  ],
  "dependencies": {
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "js-beautify": "^2.0.3",
    "source-map-js": "^1.2.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": "./dist/index.mjs"
  }
}
